<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>清新記帳</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        :root {
            --primary: #5AC8FA; /* 淺藍色 */
            --accent: #34C759;  /* 淺綠色 */
            --bg: #F0F9F9;      /* 淡淡的薄荷底色 */
            --card-bg: #ffffff;
        }

        body {
            font-family: -apple-system, "SF Pro Display", sans-serif;
            background-color: var(--bg);
            margin: 0;
            padding: 20px 20px 100px 20px;
            color: #2c3e50;
        }

        /* 頂部漸變圓框 */
        .header-card {
            background: linear-gradient(135deg, var(--primary), var(--accent));
            padding: 35px 20px;
            border-radius: 30px;
            color: white;
            text-align: center;
            box-shadow: 0 10px 25px rgba(52, 199, 89, 0.2);
            margin-bottom: 25px;
        }

        .header-card span { font-size: 0.9rem; opacity: 0.9; font-weight: 500; }
        .total-amount { font-size: 3rem; font-weight: 800; margin-top: 5px; }

        /* 圓潤卡片 */
        .glass-card {
            background: var(--card-bg);
            border-radius: 28px;
            padding: 22px;
            margin-bottom: 20px;
            box-shadow: 0 6px 18px rgba(0,0,0,0.03);
        }

        h3 { font-size: 1.1rem; margin: 0 0 18px 0; color: #444; }

        /* 輸入框美化 */
        input, select {
            background: #f1f8f8;
            border: 2px solid transparent;
            padding: 15px;
            border-radius: 18px;
            width: 100%;
            margin-bottom: 12px;
            box-sizing: border-box;
            font-size: 1rem;
            transition: 0.3s;
        }
        input:focus { border-color: var(--primary); outline: none; background: #fff; }

        /* 確認按鈕 */
        .btn-confirm {
            background: var(--accent);
            color: white;
            border: none;
            padding: 16px;
            border-radius: 18px;
            width: 100%;
            font-weight: bold;
            font-size: 1rem;
            box-shadow: 0 4px 12px rgba(52, 199, 89, 0.3);
        }

        /* 圓形懸浮按鈕 (FAB) */
        .fab {
            position: fixed;
            bottom: 30px;
            right: 25px;
            width: 60px;
            height: 60px;
            background: var(--primary);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 28px;
            box-shadow: 0 8px 20px rgba(90, 200, 250, 0.4);
            border: none;
            z-index: 100;
        }

        /* 紀錄清單 */
        .list-item {
            display: flex;
            align-items: center;
            padding: 14px 0;
            border-bottom: 1px solid #f0f7f7;
        }
        .icon-circle {
            width: 48px;
            height: 48px;
            background: #e8f4f4;
            border-radius: 16px; /* 稍微方圓點 */
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            margin-right: 15px;
        }
        .item-info { flex-grow: 1; }
        .item-info div { font-weight: 600; color: #333; }
        .item-info span { font-size: 0.8rem; color: #99abb0; }
        .item-amt { font-weight: 700; color: #2ecc71; font-size: 1.1rem; }

        .chart-wrap { height: 230px; }
    </style>
</head>
<body>

<div class="header-card">
    <span>本月小計 🧊</span>
    <div class="total-amount">$<span id="totalDisplay">0</span></div>
</div>

<div class="glass-card">
    <h3>📊 消費比例</h3>
    <div class="chart-wrap">
        <canvas id="expenseChart"></canvas>
    </div>
</div>

<div class="glass-card">
    <h3>🌱 記下一筆</h3>
    <input type="number" id="amt" placeholder="入幾多錢？" inputmode="decimal">
    <select id="cat">
        <option value="食飯">🍱 食飯</option>
        <option value="交通">🚌 交通</option>
        <option value="買嘢">🛍️ 買嘢</option>
        <option value="娛樂">🎮 娛樂</option>
        <option value="其他">❓ 其他</option>
    </select>
    <button class="btn-confirm" onclick="add()">儲存紀錄</button>
</div>

<div class="glass-card">
    <h3>🗓️ 最近消費</h3>
    <div id="recordList"></div>
</div>

<button class="fab" onclick="window.scrollTo({top: 450, behavior: 'smooth'})">+</button>

<script>
    let records = JSON.parse(localStorage.getItem('myExpensesMint')) || [];
    let myChart = null;
    const catIcons = { '食飯': '🍱', '交通': '🚌', '買嘢': '🛍️', '娛樂': '🎮', '其他': '❓' };

    function updateUI() {
        const now = new Date();
        const thisMonth = records.filter(r => {
            const d = new Date(r.date);
            return d.getMonth() === now.getMonth() && d.getFullYear() === now.getFullYear();
        });

        let total = 0;
        const stats = { '食飯': 0, '交通': 0, '買嘢': 0, '娛樂': 0, '其他': 0 };
        const list = document.getElementById('recordList');
        list.innerHTML = '';

        thisMonth.forEach(re => {
            total += parseFloat(re.amount);
            stats[re.category] += parseFloat(re.amount);
            
            const div = document.createElement('div');
            div.className = 'list-item';
            div.innerHTML = `
                <div class="icon-circle">${catIcons[re.category]}</div>
                <div class="item-info">
                    <div>${re.category}</div>
                    <span>${new Date(re.date).toLocaleDateString()}</span>
                </div>
                <div class="item-amt">-$${re.amount}</div>
            `;
            list.appendChild(div);
        });

        document.getElementById('totalDisplay').innerText = total.toLocaleString();
        drawChart(stats);
        localStorage.setItem('myExpensesMint', JSON.stringify(records));
    }

    function drawChart(stats) {
        const ctx = document.getElementById('expenseChart').getContext('2d');
        if (myChart) myChart.destroy();
        myChart = new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: Object.keys(stats),
                datasets: [{
                    data: Object.values(stats),
                    // 使用淺藍與淺綠系列配色
                    backgroundColor: ['#5AC8FA', '#34C759', '#00C7BE', '#AF52DE', '#E5E5EA'],
                    borderWidth: 8,
                    borderColor: '#ffffff',
                    borderRadius: 15
                }]
            },
            options: { 
                maintainAspectRatio: false, 
                plugins: { 
                    legend: { position: 'bottom', labels: { usePointStyle: true, padding: 20 } } 
                },
                cutout: '70%'
            }
        });
    }

    function add() {
        const a = document.getElementById('amt').value;
        const c = document.getElementById('cat').value;
        if (!a) return;
        records.unshift({ amount: a, category: c, date: new Date().toISOString() });
        document.getElementById('amt').value = '';
        updateUI();
    }

    updateUI();
</script>

</body>
</html>
